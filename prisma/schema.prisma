// BookFlow AI — Phase 0–4

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationPlan {
  TRIAL
  STARTER
  GROWTH
  BUSINESS
}

enum ResourceType {
  STAFF
  ROOM
  EQUIPMENT
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum BookingSource {
  PUBLIC
  DASHBOARD
  AI
  IMPORT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum OutboxChannel {
  EMAIL
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String
  firstName   String?
  lastName    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  resources   Resource[]

  @@index([email])
  @@map("users")
}

model Organization {
  id                   String           @id @default(cuid())
  name                 String
  slug                 String           @unique
  clerkOrgId           String?          @unique
  plan                 OrganizationPlan @default(TRIAL)
  stripeCustomerId     String?          @unique
  timezoneDefault      String           @default("UTC")
  reminderHoursBefore  Int              @default(24)
  publicBookingEnabled Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  memberships  Membership[]
  locations    Location[]
  resources    Resource[]
  services     Service[]
  clients      Client[]
  bookings     Booking[]
  subscription Subscription?
  outbox       NotificationOutbox[]
  auditLogs    AuditLog[]
  aiRuns       AiRun[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole   @default(STAFF)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  timezone       String   @default("UTC")
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  country        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources    Resource[]
  bookings     Booking[]

  @@index([organizationId, isActive])
  @@map("locations")
}

model Resource {
  id             String       @id @default(cuid())
  organizationId String
  locationId     String
  name           String
  type           ResourceType @default(STAFF)
  userId         String?
  capacity       Int          @default(1)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     ServiceResource[]
  rules        AvailabilityRule[]
  overrides    AvailabilityOverride[]
  bookings     Booking[]

  @@index([organizationId, locationId])
  @@index([organizationId, isActive])
  @@map("resources")
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  durationMin    Int
  bufferBefore   Int      @default(0)
  bufferAfter    Int      @default(0)
  priceCents     Int      @default(0)
  currency       String   @default("USD")
  category       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources    ServiceResource[]
  bookings     Booking[]

  @@index([organizationId, isActive])
  @@map("services")
}

model ServiceResource {
  id         String @id @default(cuid())
  serviceId  String
  resourceId String

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, resourceId])
  @@index([resourceId])
  @@map("service_resources")
}

model AvailabilityRule {
  id         String @id @default(cuid())
  resourceId String
  weekday    Int
  startMin   Int
  endMin     Int

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, weekday])
  @@map("availability_rules")
}

model AvailabilityOverride {
  id         String  @id @default(cuid())
  resourceId String
  date       String
  isClosed   Boolean @default(false)
  startMin   Int?
  endMin     Int?

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, date])
  @@index([resourceId])
  @@map("availability_overrides")
}

model Client {
  id             String   @id @default(cuid())
  organizationId String
  email          String?
  phone          String?
  name           String
  notes          String?
  tags           String[] @default([])
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@index([organizationId, name])
  @@index([organizationId, email])
  @@map("clients")
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  locationId     String
  resourceId     String
  serviceId      String
  clientId       String
  startAt        DateTime
  endAt          DateTime
  status         BookingStatus @default(CONFIRMED)
  source         BookingSource @default(DASHBOARD)
  notes          String?
  cancelReason   String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resource     Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  service      Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  events       BookingEvent[]

  @@index([organizationId, startAt])
  @@index([resourceId, startAt, endAt])
  @@index([resourceId, status])
  @@index([clientId])
  @@map("bookings")
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  type      String
  actorId   String?
  payload   Json?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model NotificationOutbox {
  id             String        @id @default(cuid())
  organizationId String
  bookingId      String?
  channel        OutboxChannel @default(EMAIL)
  kind           String
  toAddress      String?
  payload        Json
  status         OutboxStatus  @default(PENDING)
  attempts       Int           @default(0)
  scheduledFor   DateTime
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([organizationId, status])
  @@index([bookingId])
  @@map("notification_outbox")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model AiRun {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  feature        String
  provider       String
  model          String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costCents      Int      @default(0)
  inputHash      String?
  outputPreview  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, feature])
  @@map("ai_runs")
}
