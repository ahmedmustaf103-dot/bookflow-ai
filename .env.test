# Isolated BookFlow test environment. Never point this at production.
# Loaded only by test scripts — not by `next dev`.

NODE_ENV=test
SKIP_ENV_VALIDATION=1
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100

# Dedicated local/embedded Postgres (see scripts/test-db.ts). Not prisma.io.
DATABASE_URL=postgresql://bookflow:bookflow@127.0.0.1:54329/bookflow_test
BOOKFLOW_TEST_DATABASE_URL=postgresql://bookflow:bookflow@127.0.0.1:54329/bookflow_test

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_e2e_placeholder
CLERK_SECRET_KEY=sk_test_e2e_placeholder
CLERK_WEBHOOK_SIGNING_SECRET=whsec_e2e_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Providers unset on purpose — outbox must not send real email/SMS.
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# STRIPE_SECRET_KEY=

FEATURE_FLAGS={"rate_limit":false,"slot_cache":false}
DATABASE_POOL_MAX=5
LOG_LEVEL=error

SMOKE_ORG_SLUG=e2e-test-shop
E2E_ORG_SLUG=e2e-test-shop
E2E_PORT=3100
