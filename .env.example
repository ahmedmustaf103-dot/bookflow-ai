# Environment — copy to `.env.local` and fill in real values.
# Next.js loads `.env.local` over `.env`. Never commit secrets.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SKIP_ENV_VALIDATION=0

# Database (Postgres)
# Local: postgresql://postgres:postgres@localhost:5432/bookflow
# Cloud: Neon / Prisma Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bookflow?sslmode=require

# Clerk — https://dashboard.clerk.com → Configure → API Keys
# Must be real pk_test_… / sk_test_… keys (placeholders crash the app)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Logging
LOG_LEVEL=debug
