# Environment — copy to `.env.local` and fill in real values.
# Next.js loads `.env.local` over `.env`. Never commit secrets.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SKIP_ENV_VALIDATION=0

# Database (Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bookflow?sslmode=require

# Clerk — https://dashboard.clerk.com → Configure → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Resend — https://resend.com (optional in dev; emails are logged if missing)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=BookFlow AI <onboarding@resend.dev>

# Stripe — https://dashboard.stripe.com (optional until billing is enabled)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_BUSINESS=price_...

# Cron (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace_me

# AI — OpenAI and/or Google Gemini (at least one for /dashboard/ai)
OPENAI_API_KEY=sk-...
GOOGLE_GENERATIVE_AI_API_KEY=
AI_PROVIDER=openai
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_GOOGLE=gemini-2.0-flash

# Logging
LOG_LEVEL=debug
